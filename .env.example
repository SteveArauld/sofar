APP_NAME="DFP Interiores"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dfpinteriores.com

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=contacto@dfpinteriores.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="contacto@dfpinteriores.com"
MAIL_FROM_NAME="DFP Interiores"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MAIL_ADMIN_ADDRESS="contacto@dfpinteriores.com"

FEED_BASE_URL=https://dfpinteriores.com
MERCHANT_FEED_TOKEN=
MERCHANT_CURRENCY=EUR
MERCHANT_TARGET_COUNTRY=PT
MERCHANT_DEFAULT_BRAND="DFP Interiores"
MERCHANT_SHIPPING_PRICE=0
MERCHANT_HANDLING_MIN_DAYS=1
MERCHANT_HANDLING_MAX_DAYS=1
MERCHANT_SHIPPING_MIN_DAYS=0
MERCHANT_SHIPPING_MAX_DAYS=2
MERCHANT_RETURN_DAYS=14
