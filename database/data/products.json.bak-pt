      "Composição": "Mola Ensacada Adapt-Tech",
      "Enchimento": "Fibercel e Poliéter",
      "Revestimento": "Tecido Stretch c\\/ Tripla Barreira",
      "Nível de Firmeza": "Alto"
    },
