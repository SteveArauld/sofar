      "Assentos Extensíveis": "Não",
      "Mecanísmo Relax": "Sim (Elétrico)",
      "Baú de Arrumação": "Não",
      "Convertível em Cama": "Não",
      "Composição de Assentos e Encostos": "Espuma"
    },
